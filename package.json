{
  "name": "hardhat-multibaas-plugin",
  "version": "2.0.0",
  "description": "Hardhat v3 MultiBaas plugin using Ignition",
  "license": "MIT",
  "author": "Curvegrid",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ignition": {
      "types": "./dist/ignition.d.ts",
      "default": "./dist/ignition.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist/src",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@curvegrid/multibaas-sdk": "1.1.0"
  },
  "peerDependencies": {
    "hardhat": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^3.0.0",
    "@nomicfoundation/ignition-core": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.3"
  }
}
