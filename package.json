{
  "name": "hardhat-multibaas-plugin",
  "version": "2.0.0",
  "description": "Hardhat v3 MultiBaas plugin using Ignition",
  "license": "MIT",
  "author": "Curvegrid",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ignition": {
      "types": "./dist/ignition.d.ts",
      "default": "./dist/ignition.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist/src",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist",
    "fix": "eslint --fix '{*,**/*}.{js,ts}'"
  },
  "dependencies": {
    "@curvegrid/multibaas-sdk": "1.1.0"
  },
  "peerDependencies": {
    "hardhat": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^3.0.0",
    "@nomicfoundation/ignition-core": "^3.0.0"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --fix",
    "*.json": "prettier --write"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
